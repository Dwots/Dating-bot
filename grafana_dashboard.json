{
  "dashboard": {
    "title": "Dating Bot Metrics",
    "panels": [
      {
        "title": "Запросы в секунду",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(bot_requests_total[5m])",
            "legendFormat": "{{handler}}"
          }
        ]
      },
      {
        "title": "Cache Hit Rate",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "cache_hits_total / (cache_hits_total + cache_misses_total) * 100",
            "legendFormat": "Hit Rate %"
          }
        ]
      },
      {
        "title": "Cache Hits vs Misses",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "rate(cache_hits_total[5m])",
            "legendFormat": "Cache Hits"
          },
          {
            "expr": "rate(cache_misses_total[5m])",
            "legendFormat": "Cache Misses"
          }
        ]
      },
      {
        "title": "RabbitMQ сообщений отправлено",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "rate(rabbitmq_messages_published_total[5m])",
            "legendFormat": "{{routing_key}}"
          }
        ]
      },
      {
        "title": "Время обработки запросов (p95)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(request_duration_seconds_bucket[5m]))",
            "legendFormat": "p95 {{handler}}"
          }
        ]
      }
    ],
    "schemaVersion": 16,
    "version": 1
  },
  "overwrite": true
}